          "verse-editor-bracket-match-border": "#52525b"
        },
        "status_overrides": {}
      }
    ],
    "walkthrough": {
      "id": "light",
      "title": "Light theme",
      "auto_start": "first_enable",
      "settings_tab": "Appearance",
      "steps": [
        {
          "target": "settings.tab.appearance",
          "title": "Appearance",
          "body": "This theme is available in Appearance. Press Appearance, then pick Light for soft surfaces and a blue accent.",
          "advance": "require_click",
          "mode": "rect"
        }
      ]
    }
  },
  "backend": {
    "entry": "backend",
    "register": "register"
  }
}
