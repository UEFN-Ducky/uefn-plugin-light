{
  "id": "light",
  "kind": "plugin",
  "version": "1.0.8",
  "label": "Light",
  "description": "Clean light appearance theme for UEFN Ducky \u2014 soft surfaces, blue accent.",
  "min_app_version": "1.0.466",
  "default_enabled": false,
  "secret_keys": [],
  "contributes": {
    "appearance.profiles": [
      {
        "id": "light",
        "name": "Light",
        "foundation": {
          "accent": "#2563eb",
          "bg": "#f4f4f5",
          "surface": "#ffffff",
          "text": "#18181b",
          "border": "#d4d4d8"
        },
        "overrides": {
          "accent-hover": "#1d4ed8",
          "select": "#93c5fd",
          "border-focus": "#2563eb",
          "sidebar": "#ececef",
          "panel-header": "#f0f0f2",
          "card": "#ffffff",
          "card-hover": "#f4f4f5",
          "bg-elevated": "#fafafa",
          "dropdown-bg": "#ffffff",
          "btn-bg": "#e4e4e7",
          "btn-hover": "#d4d4d8",
          "btn-pressed": "#c4c4c8",
          "fg": "#18181b",
          "fg-dim": "#52525b",
          "fg-inverse": "#ffffff",
          "muted": "#71717a",
          "border": "#d4d4d8",
          "border-light": "#a1a1aa",
          "green": "#16a34a",
          "red": "#dc2626",
          "amber": "#d97706",
          "blue": "#2563eb",
