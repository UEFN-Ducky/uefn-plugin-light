          "amber-dim": "rgba(217, 119, 6, 0.12)",
          "blue-dim": "rgba(37, 99, 235, 0.12)",
          "on-green": "#ffffff",
          "on-amber": "#18181b",
          "shadow-sm": "0 1px 2px rgba(0, 0, 0, 0.06)",
          "shadow-md": "0 8px 16px rgba(0, 0, 0, 0.1)",
          "shadow-lg": "0 12px 40px rgba(0, 0, 0, 0.12)",
          "shadow-glow": "0 0 15px rgba(37, 99, 235, 0.18)",
          "shadow-dropdown": "0 10px 30px rgba(0, 0, 0, 0.14)",
          "terminal-bg": "#f4f4f5",
          "terminal-fg": "#18181b",
          "terminal-cursor": "#18181b",
          "terminal-selection": "#93c5fd",
          "verse-syntax-comment": "#6b7280",
          "verse-syntax-keyword": "#7c3aed",
          "verse-syntax-type": "#0284c7",
          "verse-syntax-type-id": "#0284c7",
          "verse-syntax-tag": "#c2410c",
          "verse-syntax-identifier": "#1d4ed8",
          "verse-syntax-path": "#0369a1",
          "verse-syntax-string": "#b45309",
          "verse-syntax-string-char": "#a16207",
          "verse-syntax-string-escape": "#ca8a04",
          "verse-syntax-error": "#dc2626",
          "verse-syntax-number": "#15803d",
          "verse-syntax-operator": "#52525b",
          "verse-syntax-operator-arith": "#52525b",
          "verse-syntax-operator-compare": "#52525b",
          "verse-syntax-operator-logical": "#7c3aed",
          "verse-syntax-bracket": "#a16207",
          "verse-editor-bg": "#f4f4f5",
          "verse-editor-fg": "#18181b",
          "verse-editor-gutter": "#f4f4f5",
          "verse-editor-line-number": "#a1a1aa",
          "verse-editor-line-number-active": "#52525b",
          "verse-editor-cursor": "#d97706",
